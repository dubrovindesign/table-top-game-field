{
  "name": "hex-board-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/roomServer.ts",
    "dev:vite-only": "vite",
    "dev:open": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"vite --open\"",
    "dev:vite-only:open": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "preview:open": "vite preview --host --open",
    "preview:mp": "npm run build && concurrently -n ws,preview -c blue,magenta \"tsx server/roomServer.ts\" \"vite preview --host\"",
    "preview:mp:open": "npm run build && concurrently -n ws,preview -c blue,magenta \"tsx server/roomServer.ts\" \"vite preview --host --open\"",
    "start:room": "tsx server/roomServer.ts",
    "catalog:apply": "node scripts/apply-catalog-export.mjs",
    "catalog:bundle": "node scripts/build-catalog-bundle.mjs",
    "catalog:extract-images": "node scripts/extract-catalog-base64-images.mjs",
    "optimize:webp": "node scripts/optimize-public-webp.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.12",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
