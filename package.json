{
  "name": "hex-board-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:preview": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"vite --port 5280 --strictPort\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/roomServer.ts",
    "dev:vite-only": "vite",
    "dev:open": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"vite --open\"",
    "dev:vite-only:open": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "preview:open": "vite preview --host --open",
    "preview:mp": "npm run build && concurrently -n ws,preview -c blue,magenta \"tsx server/roomServer.ts\" \"vite preview --host\"",
    "preview:mp:open": "npm run build && concurrently -n ws,preview -c blue,magenta \"tsx server/roomServer.ts\" \"vite preview --host --open\"",
    "start:room": "tsx server/roomServer.ts",
    "catalog:apply": "tsx scripts/apply-catalog-export.ts",
    "catalog:bundle": "node scripts/build-catalog-bundle.mjs",
    "catalog:extract-images": "node scripts/extract-catalog-base64-images.mjs",
    "catalog:verify-assets": "node scripts/verify-catalog-public-assets.mjs",
    "priory:catalog": "node scripts/generate-priory-catalog.mjs",
    "priory:ingest": "node scripts/generate-priory-catalog.mjs && npm run catalog:bundle",
    "broomgar:catalog": "node scripts/generate-broomgar-catalog.mjs",
    "broomgar:ingest": "node scripts/generate-broomgar-catalog.mjs && npm run catalog:bundle",
    "mercenaries-kow:catalog": "node scripts/generate-mercenaries-kow-catalog.mjs",
    "mercenaries-kow:ingest": "node scripts/generate-mercenaries-kow-catalog.mjs && npm run catalog:bundle",
    "engeln:catalog": "node scripts/generate-engeln-catalog.mjs",
    "engeln:icon": "node scripts/make-engeln-faction-icon.mjs",
    "engeln:ingest": "node scripts/generate-engeln-catalog.mjs && node scripts/make-engeln-faction-icon.mjs && npm run catalog:bundle",
    "engeln:singles": "node scripts/ingest-engeln-singles.mjs && node scripts/generate-engeln-singles-catalog.mjs && npm run catalog:bundle",
    "engeln:tornscape": "node scripts/generate-engeln-tornscape-catalog.mjs && npm run catalog:bundle",
    "optimize:webp": "node scripts/optimize-public-webp.mjs",
    "tornscape:batch": "tsx scripts/batch-ingest-tornscape-cards.ts",
    "sync-roster-max-copies": "tsx scripts/sync-roster-max-copies.ts",
    "import-game-structure": "tsx scripts/import-game-structure-catalog.ts --root D:/Downloads/parsing",
    "import-game-structure:ocr": "tsx scripts/import-game-structure-catalog.ts --root D:/Downloads/parsing --ocr",
    "import-game-structure:ocr-blackthorn": "tsx scripts/import-game-structure-catalog.ts --root D:/Downloads/parsing --ingest-only --ocr --ocr-faction blackthorn",
    "import-game-structure:god-cards": "tsx scripts/import-game-structure-catalog.ts --root D:/Downloads/parsing --only-god-cards",
    "test:protocol": "tsx --test tests/multiplayer/protocol.test.ts",
    "test:scenarios-official": "tsx --test tests/server/officialScenarioCatalog.test.ts src/scenarios/official.test.ts tests/multiplayer/protocol.test.ts"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.12",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
