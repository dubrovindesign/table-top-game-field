# Copy to .env.local for local overrides (not committed).

# --- Multiplayer WebSocket (baked into the client at `npm run build`) ---
# Production: must be wss:// when the site is served over https://
# Example same host + reverse proxy path (variant A):
#   VITE_MP_WS_URL=wss://your.domain.example/__mp_ws
# Example separate API host (variant B):
#   VITE_MP_WS_URL=wss://mp.your.domain.example
#
# Leave unset for local dev: the app uses same-origin /__mp_ws via Vite proxy.
# VITE_MP_WS_URL=

# --- Room server process (Node, not Vite) ---
# Port the room server listens on (default 3333).
# MP_PORT=3333
