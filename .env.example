# Copy to .env.local for local overrides (not committed).

# --- Multiplayer WebSocket (baked into the client at `npm run build`) ---
# Production: must be wss:// when the site is served over https://
# Example same host + reverse proxy path (variant A):
#   VITE_MP_WS_URL=wss://your.domain.example/__mp_ws
# Example separate API host (variant B):
#   VITE_MP_WS_URL=wss://mp.your.domain.example
#
# Leave unset for local dev: the app uses same-origin /__mp_ws via Vite proxy.
# VITE_MP_WS_URL=

# --- WebRTC voice (optional JSON array of RTCIceServer, baked in at build) ---
# Default: public STUN only. For strict NAT / production reliability add TURN here.
# Example (single line):
#   VITE_RTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:…","username":"…","credential":"…"}]
# VITE_RTC_ICE_SERVERS=

# --- Room server process (Node, not Vite) ---
# Port the room server listens on (default 3333).
# MP_PORT=3333
#
# How long (ms) to keep an empty room after the last client disconnects, so reload/reconnect
# can still restore boardState. Default 600000 (10 minutes). Set to 0 to delete immediately.
# MP_ROOM_EMPTY_TTL_MS=600000
